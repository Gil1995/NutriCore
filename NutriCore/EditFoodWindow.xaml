<Window x:Class="NutriCore.EditFoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NutriCore"
        mc:Ignorable="d"       
        Loaded="Window_Loaded"
        Title="NutriCore - Lebensmittel ändern" Height="300" Width="450"
        Icon="C:\Users\bella\source\repos\NutriCore\NutriCore\resources\KnobiRound.ico">

    <Grid>    
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#3c0f55" Offset="0.0"/>
                    <GradientStop Color="#c31591" Offset="2.1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>                
        </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Button">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="Template">
                    <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="7"
                                        Padding="10"                                        
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                    Property="Background"
                                    Value="#3c0f55"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                    Property="Background"
                                    Value="#c31591"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>           
        </Grid.Resources>
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="15"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Text="{Binding ToEdit.Name}" 
                   FontWeight="Bold" FontSize="17"                  
                   Foreground="#f9d600"
                   FontFamily="Century Schoolbook"
                   TextWrapping="Wrap">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
            </TextBlock.Effect>
        </TextBlock>
        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Label FontSize="13">
                Getrackte Menge [g]
            </Label>
        <TextBox x:Name="QuantityBox"
                 Height="Auto"
                 TextAlignment="Center"
                 Text="{Binding ToEdit.QuantityTracked}"
                 FontSize="13"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Width="75"
                 Background="Transparent"
                 BorderBrush="Black"/>
        </StackPanel>
        <Button x:Name="ChangeQuant" 
                Grid.Column="0" Grid.Row="2"
                Margin="10"
                Content="Menge ändern"
                FontSize="15"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="Auto" Click="ChangeQuant_Click"/>
        <Button x:Name="DeleteFood" 
                Grid.Column="1" Grid.Row="2"
                Margin="10"
                Content="Lebensmittel löschen"
                FontSize="15"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="Auto" Click="DeleteFood_Click"/>
    </Grid>
</Window>
