<Window x:Class="NutriCore.AddFoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NutriCore"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="NutriCore - Lebensmittel tracken" Height="500" Width="750"
        Icon="C:\Users\bella\source\repos\NutriCore\NutriCore\resources\KnobiRound.ico">
    <Grid>       
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                            <GradientStop Color="#3c0f55" Offset="0.0"/>
                            <GradientStop Color="#c31591" Offset="2.1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>                       
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>                  

                    <TextBox x:Name="SearchBox" Grid.Column="0" Grid.Row="0"                                         
                         Text="{Binding SearchInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="25" Margin="10,10,5,10">
                        <TextBox.Style>
                            <Style TargetType="TextBox" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <Style.Resources>
                                    <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                        <VisualBrush.Visual>
                                            <Label Content="Zum Suchen Namen eingeben" Foreground="LightGray" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button x:Name="SearchButton" Grid.Column="1" Grid.Row="0" 
                        Height="25" Width="25" HorizontalAlignment="Left" Margin="0,10,0,10"
                        Command="{Binding SendSearchCommand}">
                        <Button.Content>
                            <Image Source="pack://application:,,,/NutriCore;component/resources/Lupe.jpg" Stretch="Uniform"/>
                        </Button.Content>
                    </Button>

        <Border Grid.Row="1" Grid.Column="0"
                CornerRadius="10" Padding="7"
                Margin="15">

            <Border.Background>
                <SolidColorBrush Color="Gray" Opacity="0.5"/>
            </Border.Background>
            <ListBox         BorderThickness="0"
                             Background="Transparent"
                             x:Name="SearchResults"
                             ItemsSource="{Binding SearchedEntries}"
                             SelectedItem="{Binding SelectedFood, Mode=TwoWay}"
                             Margin="7">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                CornerRadius="7"
                                                Padding="7">
                                            <Border.Background>
                                                <SolidColorBrush Color="Gray" Opacity="0.3"/>
                                            </Border.Background>
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#c31591"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#3c0f55"/>
                                                <Setter Property="Foreground" Value="#f9d600" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Show}"
                                           FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel x:Name="MakroDetails" Grid.Column="1" Grid.Row="1" 
                            Visibility="{Binding MakroDetailsVisibility}" Margin="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedFood.FoodName}" FontWeight="Bold" FontSize="21"
                                   TextWrapping="Wrap"
                                   Margin="0,10"
                                   TextDecorations="Underline"
                                   Foreground="#f9d600"
                                   FontFamily="Century Schoolbook">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Nährwerte pro 100g: "
                                   Margin="0,10"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedFood.Enercc, StringFormat='Energie (kcal): {0:F2}'}"
                                   Margin="0,10"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding SelectedFood.Fat, StringFormat='Fett (g): {0:F2}'}"
                                   Margin="0,10"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding SelectedFood.Cho, StringFormat='Kohlenhydrate (g): {0:F2}'}"
                                   Margin="0,10"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding SelectedFood.Prot625, StringFormat='Protein (g): {0:F2}'}"
                                   Margin="0,10"
                                   FontSize="15"/>
                        <TextBlock Text="{Binding SelectedFood.Fibt, StringFormat='Ballaststoffe (g): {0:F2}'}"
                                   Margin="0,10"
                                   FontSize="15"/>
            <TextBox
                        x:Name="QuantityTextbox"                                                 
                        Height="20" Width="150" Margin="10,5,10,5">
                            <TextBox.Style>
                                <Style TargetType="TextBox" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <Style.Resources>
                                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <Label Content="Verzehrmenge in Gramm" Foreground="LightGray" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="LightGray" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

            <Button Content="Speichern" 
                    FontSize="13"
                            Command="{Binding AddAndCloseCommand}"
                            CommandParameter="{Binding Text, ElementName=QuantityTextbox}"
                            Width="90"
                    Margin="10,0,10,5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Gray"/>
                        <Setter Property="Opacity" Value="0.7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            CornerRadius="7"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#3c0f55"/>
                                        </Trigger>

                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border"
                                                    Property="Background"
                                                    Value="#c31591"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
            
                </Grid>
       
</Window>
