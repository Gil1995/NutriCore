<Window
        WindowStartupLocation="CenterScreen"    
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NutriCore"
        xmlns:src="clr-namespace:NutriCore.src" x:Class="NutriCore.MainWindow"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="NutriCore" Height="500" Width="750"
        Icon="C:\Users\bella\source\repos\NutriCore\NutriCore\resources\KnobiRound.ico"
        Loaded="Window_Loaded">

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
            <GradientStop Color="#3c0f55" Offset="0.0"/>
            <GradientStop Color="#c31591" Offset="2.1"/>
        </LinearGradientBrush>
    </Window.Background>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WindowClosingCommand}" PassEventArgsToCommand="True" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

<Grid Background="Transparent" Margin="-2,0,0,-2">
    <TabControl TabStripPlacement="Bottom" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Background="Transparent" BorderThickness="0">

        <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
                <i:InvokeCommandAction Command="{Binding ProfileTabChangedCommand}" 
                                           PassEventArgsToCommand="True"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>

        <TabControl.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Border" BorderThickness="0" CornerRadius="5,5,0,0" Background="Transparent" Padding="10,3">
                                <ContentPresenter x:Name="ContentSite" 
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      ContentSource="Header" Margin="10"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.FontSize="13"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- Hintergrund Tab, wenn ausgewählt -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="ContentSite" Property="TextElement.Foreground"
                                                Value="Black"/>
                                    </Trigger>
                                <!-- Hintergrund Tab, wenn nicht ausgewählt -->
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="#3c0f55"/>
                                    <Setter TargetName="ContentSite" Property="TextElement.Foreground"
                                                Value="#f9d600"/>
                                    
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <TabItem Header="Info">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <TextBlock  Grid.Column="0" Grid.Row="0" 
                                Text="Hinweis"
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock  Grid.Column="1" Grid.Row="0"
                                Text="Informative Links:"
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                            </TextBlock.Effect>
                    </TextBlock>

                <Border 
                        Margin="3"
                        Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="Gray" Opacity="0.7"/>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Margin="3"
                                   FontSize="13"
                                   FontWeight="DemiBold"                                   
                                   TextWrapping="Wrap"
                                   Padding="5"
                                   TextAlignment="Center">
                            
                           
                            Bitte informiere dich ausgiebig, bevor du deine Diät in Angriff nimmst.
                            <LineBreak/>
                            <LineBreak/>
                            Dieses Programm ist ein rein privates Projekt zu Lern- und Demonstrationszwecken.
                            Es besteht kein Anspruch auf Richtigkeit, Vollständigkeit oder Aktualität der dargestellten Daten.
                            Die Nutzung erfolgt auf eigene Verantwortung.
                            Es wird keinerlei Gewährleistung oder Haftung für Schäden oder Fehlberechnungen übernommen.
                            <LineBreak/>
                            <LineBreak/>
                            Die Lebensmitteldaten stammen aus dem Bundes-Lebensmittel-Schlüssel(BLS) des Max-Rubner-Instituts
                            <LineBreak/>
                            Version 4.0. Karlsruhe (2025)
                        </TextBlock>


                        <TextBlock x:Name="ImpressumTextBlock"
                                       Grid.Row="1"
                                       Text="Impressum"
                                       TextDecorations="Underline"
                                       MouseLeftButtonDown="ImpressumTextBlock_MouseLeftButtonDown"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#6705ad"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Border 
                        Margin="5"
                        Grid.Column="1" Grid.Row="1"
                        VerticalAlignment="Center"
                        CornerRadius="10" Padding="10" HorizontalAlignment="Center">

                    <Border.Background>
                        <SolidColorBrush Color="Gray" Opacity="0.7"/>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox 
                             Grid.Row="0"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             Background="Transparent">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Style>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#6705ad"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><!-- Überschrift --><Run Text="DGE - Deutsche Gesellschaft für Ernährung"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><!-- Klickbarer Link --><Hyperlink NavigateUri="https://www.dge.de/gesunde-ernaehrung/gut-essen-und-trinken/dge-empfehlungen/"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="DGE - Ernährungsempfehlungen"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="BZfE - Bundeszentrum für Ernährung"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://www.bzfe.de/presse/pressemeldungen-archiv/neue-ernaehrungsempfehlungen-fuer-deutschland"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="BZfe - Ernährungsempfehlungen"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="BZfE - Bundeszentrum für Ernährung"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://www.bzfe.de/essen-und-gesundheit/naehrstoffe/ballaststoffe"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="Ballaststoffe"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="TK - Die Techniker"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://www.tk.de/techniker/gesundheit-foerdern/gesunde-ernaehrung-2164538"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="TK - Gesunde Ernährung"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="Akademie für Sport und Gesundheit"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://www.akademie-sport-gesundheit.de/magazin/makronaehrstoffe-berechnen.html"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="Kalorien und Makrobedarf"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="ZES - Zentrum Endokrinologie und Stoffwechsel"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://endokrinologie.bayern/blog/ernaehrungsplan-zum-abnehmen-ihr-weg-zu-einem-gesunden-gewicht/"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="Ernährungsplan zum Abnehmen"/></Hyperlink></TextBlock>

                            <TextBlock TextAlignment="Center"
                                   Margin ="0,0,0,5"><Run Text="WHO - World Health Organisation"
                                   FontSize="13"
                                   FontWeight="DemiBold"/><LineBreak/><Hyperlink NavigateUri="https://www.who.int/europe/news-room/fact-sheets/item/nutrition---maintaining-a-healthy-lifestyle"
                                   RequestNavigate="Hyperlink_RequestNavigate"><Run Text="WHO - Ernährungsempfehlungen (Englisch)"/></Hyperlink></TextBlock>
                        </ListBox>

                        <TextBlock 
                                Grid.Row="1"
                                FontSize="11"
                                FontWeight="SemiBold"                               
                                TextAlignment="Center"
                                TextWrapping="Wrap">
                            <LineBreak/>
                            Diese Links dienen zu Informationszwecken.
                            <LineBreak/>
                            Für den Inhalt sind die Betreiber der Websites verantwortlich.
                            <LineBreak/>
                            Außerdem sind dies allgemeine Informationen, bei Erkrankungen oder anderen Einschränkungen in deiner Ernährung
                                solltest du einen Ernährungsspezialisten zu Rate ziehen.
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- maybe später als "tage die getrackt wurden" - Übersicht verwenden
            
            <TabItem Header="Kalender">
                <Viewbox>
                    <Calendar HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch" 
                              Background="#dad9db"
                              BorderThickness="0">
                        <Calendar.Effect>
                            <DropShadowEffect/>
                        </Calendar.Effect>
                    </Calendar>
                </Viewbox>
            </TabItem>
                -->

        <TabItem Header="Tracking" IsSelected="True">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <DatePicker Grid.ColumnSpan="2"
                                x:Name="TrackingDatePicker" Width="250" 
                                BorderThickness="0" Margin="10"
                                Padding="0"
                                HorizontalContentAlignment="Center"  
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                SelectedDate="{Binding ChosenDateDateTime, Mode=TwoWay}"
                                Background="Transparent">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Background" Value="#80A9A9A9"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                    <TextBlock     Grid.Row="1" Grid.Column="0" Margin="0,5,0,5"
                                   Text="Deine Makros" 
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock     Grid.Row="1" Grid.Column="1" Margin="0,5,0,5"
                                   Text="Heute getrackte Lebensmittel" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>


                <Grid Grid.Column="0" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--Anzeige Kcal-->
                    <Border Grid.Row="0" CornerRadius="10" Padding="0" 
                                Width="300" Height="40">
                        <Border.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.5"/>
                        </Border.Background>
                        <Grid VerticalAlignment="Center" 
                                  Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Makro Name -->
                                <ColumnDefinition Width="*"/>
                                <!-- getrackt / max -->
                                <ColumnDefinition Width="*"/>
                                <!-- Progressbar -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                           Text="Kcal: "
                                           TextAlignment="Left"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>

                            <TextBlock Grid.Column="1"    
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" {0} / {1}">
                                        <Binding Path="TrackingVar.Kcal"/>
                                        <Binding Path="User.KcalMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <ProgressBar Grid.Column="2"
                                             Minimum="0"
                                             Value="{Binding TrackingVar.Kcal}"
                                             Maximum="{Binding User.KcalMax}"
                                             Background="GhostWhite"
                                             Foreground="#498467"
                                             BorderThickness="0"
                                             HorizontalAlignment="Left" Height="10" 
                                             Margin="0,0,0,0" Width="100"/>
                        </Grid>
                    </Border>
                    <!--Anzeige Kohlenhydrate-->
                    <Border Grid.Row="1" CornerRadius="10" Padding="0" 
                                Width="300" Height="40"
                                Margin="0">

                        <Border.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.5"/>
                        </Border.Background>
                        <Grid VerticalAlignment="Center" 
                                  Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                           Text="Kohlenhydrate: "
                                           TextAlignment="Left"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>

                            <TextBlock Grid.Column="1"    
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" {0} / {1}">
                                        <Binding Path="TrackingVar.Cho"/>
                                        <Binding Path="User.ChoMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <ProgressBar Grid.Column="2"
                                     Minimum="0"
                                     Value="{Binding TrackingVar.Cho}"
                                     Maximum="{Binding User.ChoMax}"
                                     Background="GhostWhite"
                                     Foreground="#498467"
                                     BorderThickness="0"
                                     HorizontalAlignment="Left" Height="10" Margin="0,0,0,0" Width="100"/>
                        </Grid>
                    </Border>
                    <!--Anzeige Proteine-->
                    <Border Grid.Row="2" CornerRadius="10" Padding="0" 
                                Width="300" Height="40"
                                Margin="0">
                        <Border.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.5"/>
                        </Border.Background>
                        <Grid VerticalAlignment="Center" 
                                  Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                           Text="Protein: "
                                           TextAlignment="Left"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>

                            <TextBlock Grid.Column="1"    
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" {0} / {1}">
                                        <Binding Path="TrackingVar.Prot"/>
                                        <Binding Path="User.ProtMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <ProgressBar Grid.Column="2"
                                     Minimum="0"
                                     Value="{Binding TrackingVar.Prot}"
                                     Maximum="{Binding User.ProtMax}"
                                     Background="GhostWhite"
                                     Foreground="#498467"
                                     BorderThickness="0"
                                     HorizontalAlignment="Left" Height="10" Margin="0,0,0,0" Width="100"/>
                        </Grid>
                    </Border>
                    <!--Anzeige Fett-->
                    <Border Grid.Row="3" CornerRadius="10" Padding="0" 
                                Width="300" Height="40"
                                Margin="0">
                        <Border.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.5"/>
                        </Border.Background>
                        <Grid VerticalAlignment="Center" 
                                  Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                           Text="Fett: "
                                           TextAlignment="Left"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>

                            <TextBlock Grid.Column="1"    
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" {0} / {1}">
                                        <Binding Path="TrackingVar.Fat"/>
                                        <Binding Path="User.FatMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>


                            <ProgressBar Grid.Column="2"
                                     Minimum="0"
                                     Value="{Binding TrackingVar.Fat}"
                                     Maximum="{Binding User.FatMax}"
                                     Background="GhostWhite"
                                     Foreground="#498467"
                                     BorderThickness="0"
                                     HorizontalAlignment="Left" Height="10" Margin="0,0,0,0" Width="100"/>
                        </Grid>
                    </Border>
                    <!--Anzeige Ballaststoffe-->
                    <Border Grid.Row="4" CornerRadius="10" Padding="0" 
                                Width="300" Height="40"
                                Margin="0">
                        <Border.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.5"/>
                        </Border.Background>
                        <Grid VerticalAlignment="Center" 
                                  Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                           Text="Ballaststoffe: "
                                           TextAlignment="Left"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>

                            <TextBlock Grid.Column="1"    
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"
                                           FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat=" {0} / {1}">
                                        <Binding Path="TrackingVar.Fiber"/>
                                        <Binding Path="User.FiberMax"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <ProgressBar Grid.Column="2"
                                             Minimum="0"
                                             Value="{Binding TrackingVar.Fiber}"
                                             Maximum="{Binding User.FiberMax}"
                                             Background="GhostWhite"
                                             Foreground="#498467"
                                             BorderThickness="0"
                                             HorizontalAlignment="Left" Height="10" Margin="0,0,0,0" Width="100"/>
                        </Grid>
                    </Border>
                    <!-- Gedacht für Wasser - einbauen wenn noch Zeit
                        <ProgressBar Grid.Row="5" Grid.Column="1"
                                         HorizontalAlignment="Center" Height="10" Margin="0,0,0,0" Width="100"/> -->
                </Grid>

                <Border Grid.Row="2" Grid.Column="1"
                        CornerRadius="10" Padding="10"
                        Margin="10">

                    <Border.Background>
                        <SolidColorBrush Color="Gray" Opacity="0.5"/>
                    </Border.Background>
                    <ListBox x:Name="TrackingListbox"  
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding DBEntriesTracked}"
                             SelectedItem="{Binding SelectedEntry}"
                             MouseDoubleClick="TrackingListbox_MouseDoubleClick">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                            CornerRadius="7"
                                                            Padding="8">
                                                <Border.Background>
                                                    <SolidColorBrush Color="Gray" Opacity="0.3"/>
                                                </Border.Background>
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#c31591"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border"
                                                                    Property="Background"
                                                                    Value="#3c0f55"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding ShortenName}"                                                
                                                   Grid.Column="0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding UnifyQuantity}" 
                                                   Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Button Name="AddLM" Grid.Column="1" Grid.Row="4" 
                            Margin="5"
                            Content="Lebensmittel hinzufügen" 
                            Width="250"
                            Click="AddLM_Click"
                            FontSize="17"
                            FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Gray"/>
                            <Setter Property="Opacity" Value="0.7"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                    CornerRadius="7"
                                                    Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="#3c0f55"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border"
                                                            Property="Background"
                                                            Value="#c31591"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>


            </Grid>
        </TabItem>
        <TabItem Header="Profil">
            <Grid Margin="10">

                <Grid.Resources>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#c31591"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="15"
                               Text="Persönliche Daten"
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Grid.Row="0" Margin="15"
                               Text="Tracking-Tagesziele"
                               FontSize="23"
                               FontWeight="Thin"
                               TextAlignment="Center"
                               Foreground="#f9d600"
                               FontFamily="Century Schoolbook">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="5"
                                              Direction="45"
                                              Color="Black"
                                              Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="5,10,5,10" HorizontalAlignment="Center">
                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Name" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Start-Gewicht [kg]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.StartingWeight, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Ziel-Gewicht [kg]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.WeightGoal, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Persönliche Motivation" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.Motivation, UpdateSourceTrigger=PropertyChanged}"/>


                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Margin="5,10,5,10" HorizontalAlignment="Center">
                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Kilokalorien" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.KcalMax, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Kohlenhydrate [g]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.ChoMax, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Protein [g]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.ProtMax, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Fett [g]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.FatMax, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Ballaststoffe [g]" HorizontalContentAlignment="Center"/>
                    <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0" HorizontalContentAlignment="Center"
                        Text="{Binding User.FiberMax, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- <Label Margin="10,10,10,0" Foreground="DarkGray" Content="Wasser [L]"/>
                        <TextBox TextWrapping="Wrap" Width="200" Background="Transparent" BorderBrush="Black" Margin="10,0,10,0"
                        Text="{Binding User.WaterMax, UpdateSourceTrigger=PropertyChanged}"/> -->
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
